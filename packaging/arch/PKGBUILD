# Maintainer: openOODA-tools <ops@openooda.org>
pkgname=oosftp-bin
_pkgname=oosftp
pkgver=0.1.0
pkgrel=1
pkgdesc="Interactive and scripted SFTP client with capability-isolated local sandbox."
arch=('x86_64')
url="https://github.com/openOODA-tools/oosftp"
license=('Apache-2.0')
depends=('glibc')
provides=('oosftp')
conflicts=('oosftp')
source_x86_64=("${url}/releases/download/v${pkgver}/oosftp-linux-x86_64"
               "uninstall.sh::https://raw.githubusercontent.com/openOODA-tools/${_pkgname}/v${pkgver}/uninstall.sh")
sha256sums_x86_64=('SKIP'
                   'SKIP')

package() {
    install -Dm755 "${srcdir}/oosftp-linux-x86_64" "${pkgdir}/usr/bin/oosftp"
    install -Dm755 uninstall.sh "${pkgdir}/usr/bin/oosftp-uninstall"
}
